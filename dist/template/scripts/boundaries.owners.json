{
  "owners": [
    [
      "contracts/",
      "contracts"
    ],
    [
      "packages/contracts/",
      "contracts"
    ],
    [
      "packages/core/src/{{FEATURE_SRC_DIR}}/",
      "{{FEATURE_OWNER}}"
    ],
    [
      "scripts/",
      "infra"
    ],
    [
      "features/steps/",
      "steps"
    ]
  ],
  "glue": [
    "infra",
    "steps"
  ],
  "aliases": [
    [
      "@contracts/",
      "packages/contracts/src/"
    ],
    [
      "@core/",
      "packages/core/src/"
    ]
  ],
  "scanDirs": [
    "packages",
    "apps",
    "scripts"
  ],
  "contractsOwner": "contracts"
}
