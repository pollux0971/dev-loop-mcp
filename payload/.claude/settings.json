      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/tools/dp.mjs\" hook user-prompt" }] }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|MultiEdit|NotebookEdit|Grep|Glob",
